<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.irs.gov/efile" targetNamespace="http://www.irs.gov/efile" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
    <xsd:annotation>
        <xsd:documentation>
            <Description>IRS e-file Schema - Form 941-X - Adjusted Employer's QUARTERLY Federal Tax Return or Claim for Refund</Description>
            <TaxYear>2026</TaxYear>
            <MaturityLevel>Final Schema Version RL109 Drop 5</MaturityLevel>
            <ReleaseDate>Nov 6 2025</ReleaseDate>
        </xsd:documentation>
    </xsd:annotation>
    
    <xsd:include schemaLocation="../../../Common/efileTypes.xsd"/>
    
    <!-- ============================================== -->
    <!-- =============== IRS Form 941-X =============== -->
    <!-- ============================================== -->
    
    <xsd:element name="IRS941X">
        <xsd:annotation>
            <xsd:documentation>IRS Form 941-X - Adjusted Employer's QUARTERLY Federal Tax Return or Claim for Refund</xsd:documentation>
        </xsd:annotation>
        
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="IRS941XType">
                    <xsd:attributeGroup ref="DocumentAttributes">
                        <xsd:annotation>
                            <xsd:documentation>Common return document attributes</xsd:documentation>
                        </xsd:annotation>
                    </xsd:attributeGroup>
                    
                    <xsd:attribute name="documentName" type="TextType" fixed="IRS941X">
                        <xsd:annotation>
                            <xsd:documentation>IRS internal use only. To avoid errors within the return, do not include the attribute name or value.</xsd:documentation>
                        </xsd:annotation>
                    </xsd:attribute>
                    
                    <xsd:attribute name="referenceDocumentId" type="IdListType">
                        <xsd:annotation>
                            <xsd:documentation>List of document IDs of forms, schedules, supporting info. etc. attached to this form.</xsd:documentation>
                        </xsd:annotation>
                    </xsd:attribute>
                    
                    <xsd:attribute name="referenceDocumentName" type="TextType" fixed="BinaryAttachment FinalPayrollInformationStatement GeneralDependencySmall IRS941ScheduleB IRS941ScheduleD IRS941ScheduleR IRS8974 IRSPayment TransferOfBusinessStatement"/>
                </xsd:extension>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:complexType name="IRS941XType">
        <xsd:sequence>
            <xsd:choice>
                <!-- Form 941 Correction Indicator -->
