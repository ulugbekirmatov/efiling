                    <xsd:annotation>
                        <xsd:documentation>
                            <Description>Form 941-SS Correction Indicator</Description>
                        </xsd:documentation>
                    </xsd:annotation>
                </xsd:element>
            </xsd:choice>
            
            <xsd:choice>
                <!-- Quarter 1 Correction Indicator -->
                <xsd:element name="Qtr1CorrectionInd" type="CheckboxType">
                    <xsd:annotation>
                        <xsd:documentation>
                            <Description>Quarter 1 Correction Indicator</Description>
                        </xsd:documentation>
                    </xsd:annotation>
                </xsd:element>
                
                <!-- Quarter 2 Correction Indicator -->
                <xsd:element name="Qtr2CorrectionInd" type="CheckboxType">
                    <xsd:annotation>
                        <xsd:documentation>
                            <Description>Quarter 2 Correction Indicator</Description>
                        </xsd:documentation>
                    </xsd:annotation>
                </xsd:element>
                
                <!-- Quarter 3 Correction Indicator -->
                <xsd:element name="Qtr3CorrectionInd" type="CheckboxType">
                    <xsd:annotation>
                        <xsd:documentation>
                            <Description>Quarter 3 Correction Indicator</Description>
                        </xsd:documentation>
                    </xsd:annotation>
                </xsd:element>
                
                <!-- Quarter 4 Correction Indicator -->
                <xsd:element name="Qtr4CorrectionInd" type="CheckboxType">
                    <xsd:annotation>
                        <xsd:documentation>
                            <Description>Quarter 4 Correction Indicator</Description>
                        </xsd:documentation>
                    </xsd:annotation>
                </xsd:element>
            </xsd:choice>
            
            <!-- Calendar Year Of the Quarter Being Corrected -->
            <xsd:element name="CorrectingReturnCalendarYrCd">
                <xsd:annotation>
                    <xsd:documentation>
                        <Description>Calendar Year Of the Quarter Being Corrected</Description>
                    </xsd:documentation>
                </xsd:annotation>
                
                <xsd:simpleType>
                    <xsd:restriction base="YearType">
                        <xsd:enumeration value="2024" />
						<xsd:enumeration value="2025" />
						<xsd:enumeration value="2026" />
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            
            <!-- Date Errors Were Discovered -->
            <xsd:element name="ErrorsDiscoveredDt" type="DateType">
                <xsd:annotation>
                    <xsd:documentation>
                        <Description>Date Errors Were Discovered</Description>
                    </xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            
			<!-- Aggregate Return Indicator -->
			<xsd:choice minOccurs="0">
