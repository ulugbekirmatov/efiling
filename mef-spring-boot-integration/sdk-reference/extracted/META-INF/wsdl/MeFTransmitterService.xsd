<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.irs.gov/a2a/mef/MeFTransmitterService.xsd" targetNamespace="http://www.irs.gov/a2a/mef/MeFTransmitterService.xsd" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
	<xsd:annotation>
		<xsd:documentation>Trading Partner Transmitter Web Services' Element Definitions</xsd:documentation>
	</xsd:annotation>
	<!-- Zip containing IRS and/or State submissions -->
	<xsd:element name="SubmissionsAttBin" type="xsd:hexBinary"/>
	<!-- Zip containing a single SubmissionReceiptsList (see efileAttachments.xsd) -->
	<xsd:element name="SubmissionRcptListAttBin" type="xsd:hexBinary"/>
	<!-- Zip containing a single AcknowledgementList (see efileAttachments.xsd) -->
	<xsd:element name="AcknowledgementListAttBin" type="xsd:hexBinary"/>
	<!-- Zip containing an Acknowledgement -->
	<xsd:element name="AcknowledgementAttBin" type="xsd:hexBinary"/>
	<!-- Zip containing a StatusRecordList -->
	<xsd:element name="StatusRecordListAttBin" type="xsd:hexBinary"/>
	<xsd:element name="SendSubmissionsRequest" type="SendSubmissionsRequestType"/>
	<xsd:element name="SendSubmissionsResponse" type="SendSubmissionsResponseType"/>
	<xsd:element name="GetNewAcksRequest" type="GetNewAcksRequestType"/>
	<xsd:element name="GetNewAcksResponse" type="GetNewAcksResponseType"/>
	<xsd:element name="GetAcksRequest" type="GetAcksRequestType"/>
	<xsd:element name="GetAcksResponse" type="GetAcksResponseType"/>
	<xsd:element name="GetAckRequest" type="GetAckRequestType"/>
	<xsd:element name="GetAckResponse" type="GetAckResponseType"/>
	<xsd:element name="GetNewSubmissionsStatusRequest" type="GetNewSubmissionsStatusRequestType"/>
	<xsd:element name="GetNewSubmissionsStatusResponse" type="GetNewSubmissionsStatusResponseType"/>
	<xsd:element name="GetSubmissionsStatusRequest" type="GetSubmissionsStatusRequestType"/>
	<xsd:element name="GetSubmissionsStatusResponse" type="GetSubmissionsStatusResponseType"/>
	<xsd:element name="GetSubmissionStatusRequest" type="GetSubmissionStatusRequestType"/>
	<xsd:element name="GetSubmissionStatusResponse" type="GetSubmissionStatusResponseType"/>
	<xsd:element name="GetAcksByMsgIDRequest" type="GetAcksByMsgIDRequestType"/>
	<xsd:element name="GetAcksByMsgIDResponse" type="GetAcksByMsgIDResponseType"/>
	<xsd:complexType name="SendSubmissionsRequestType">
		<xsd:sequence>
			<xsd:element name="SubmissionDataList" type="SubmissionDataListType"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="SendSubmissionsResponseType">
		<xsd:sequence>
			<xsd:element name="DepositId" type="DepositIdType"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="GetNewAcksRequestType">
		<xsd:sequence>
			<xsd:element name="MaxResultCnt" type="xsd:positiveInteger"/>
			<xsd:element name="ExtndAcknowledgementCategoryCd" type="ExtndAcknowledgementCategoryCdType" minOccurs="0"/>
			<xsd:element name="GovernmentAgencyTypeCd" type="GovernmentAgencyTypeCdType" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="GetNewAcksResponseType">
		<xsd:sequence>
			<xsd:element name="MoreAvailableInd" type="xsd:boolean"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="GetAcksRequestType">
		<xsd:sequence>
			<xsd:element name="SubmissionIdList" type="SubmissionIdListType"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="GetAcksResponseType">
		<xsd:sequence>
			<xsd:element name="SubmissionErrorList" type="SubmissionErrorListType"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="GetAckRequestType">
		<xsd:sequence>
			<xsd:element name="SubmissionId" type="SubmissionIdType"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="GetAckResponseType">
		<xsd:sequence/>
	</xsd:complexType>
	<xsd:complexType name="GetNewSubmissionsStatusRequestType">
		<xsd:sequence>
			<xsd:element name="MaxResultCnt" type="xsd:positiveInteger"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="GetNewSubmissionsStatusResponseType">
		<xsd:sequence>
			<xsd:element name="MoreAvailableInd" type="xsd:boolean"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="GetSubmissionsStatusRequestType">
		<xsd:sequence>
			<xsd:element name="SubmissionIdList" type="SubmissionIdListType"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="GetSubmissionsStatusResponseType">
		<xsd:sequence>
			<xsd:element name="SubmissionErrorList" type="SubmissionErrorListType"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="GetSubmissionStatusRequestType">
		<xsd:sequence>
			<xsd:element name="SubmissionId" type="SubmissionIdType"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="GetSubmissionStatusResponseType">
		<xsd:sequence/>
	</xsd:complexType>
	<xsd:complexType name="SubmissionDataType">
		<xsd:sequence>
			<xsd:element name="SubmissionId" type="SubmissionIdType"/>
			<xsd:element name="ElectronicPostmarkTs" type="xsd:dateTime" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="SubmissionDataListType">
		<xsd:sequence>
			<!-- REMOVED xsd:element name="Cnt" type="xsd:positiveInteger"/> -->
			<xsd:element name="SubmissionData" type="SubmissionDataType" minOccurs="1" maxOccurs="unbounded"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="ErrorClassificationCdType">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="SYSTEM_ERROR"/>
			<xsd:enumeration value="RESOURCE_UNAVAILABLE"/>
			<xsd:enumeration value="MESSAGE_FORMAT_ERROR"/>
			<xsd:enumeration value="SECURITY_ERROR"/>
			<xsd:enumeration value="REQUEST_ERROR"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="ErrorClassificationDetailType">
		<xsd:sequence>
			<xsd:element name="ErrorMessageTxt" type="xsd:string"/>
			<xsd:element name="ErrorClassificationCd" type="ErrorClassificationCdType"/>
			<xsd:element name="ErrorMessageCd" type="xsd:string" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="SubmissionIdListType">
		<xsd:sequence>
			<!-- REMOVED <xsd:element name="Cnt"			type="xsd:positiveInteger"/> -->
			<xsd:element name="SubmissionId" type="SubmissionIdType" minOccurs="1" maxOccurs="unbounded"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="SubmissionErrorType">
		<xsd:sequence>
			<xsd:element name="SubmissionId" type="SubmissionIdType"/>
			<xsd:element name="ErrorClassificationDetail" type="ErrorClassificationDetailType"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="SubmissionErrorListType">
		<xsd:sequence>
			<xsd:element name="Cnt" type="xsd:nonNegativeInteger"/>
			<xsd:element name="SubmissionError" type="SubmissionErrorType" minOccurs="0" maxOccurs="unbounded"/>
		</xsd:sequence>
	</xsd:complexType>
	<!-- Submission ID Type - 20 digits (EFIN + ccyyddd + 7-character alphanumeric) -->
	<xsd:simpleType name="SubmissionIdType">
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="[0-9]{13}[a-z0-9]{7}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- Deposit ID Type - maximum 80 character alphanumeric -->
	<xsd:simpleType name="DepositIdType">
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="[A-Za-z0-9]*" />
			<xsd:maxLength value="80"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- Message ID Type - 20 digits (ETIN + ccyyddd + 8-character alphanumeric) -->
	<xsd:simpleType name="MessageIdType">
		<xsd:restriction base="xsd:string">
			<xsd:pattern value="[0-9]{12}[a-z0-9]{8}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- ExtndAcknowledgementCategoryCdType Type  -->
	<xsd:simpleType name="ExtndAcknowledgementCategoryCdType">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="CORP"/>
			<xsd:enumeration value="EO"/>
			<xsd:enumeration value="PART"/>
			<xsd:enumeration value="EXCISE"/>
			<xsd:enumeration value="IND"/>
			<xsd:enumeration value="UNKN"/>
			<xsd:enumeration value="ESTRST"/>
			<xsd:enumeration value="EMPL"/>
			<xsd:enumeration value="GIFT"/>
			<xsd:enumeration value="all"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!-- GovernmentAgencyTypeCdType Type  -->
	<xsd:simpleType name="GovernmentAgencyTypeCdType">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="Federal"/>
			<xsd:enumeration value="State"/>
			<xsd:enumeration value="both"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="GetAcksByMsgIDRequestType">
		<xsd:sequence>
			<xsd:element name="MessageId" type="MessageIdType"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="GetAcksByMsgIDResponseType">
		<xsd:sequence>
			<xsd:element name="MoreAvailableInd" type="xsd:boolean"/>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>
