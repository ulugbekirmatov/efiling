<?xml version="1.0" encoding="UTF-8"?>

<xsd:schema xmlns="http://www.irs.gov/efile" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.irs.gov/efile" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">

	

	<xsd:annotation>

		<xsd:documentation>

			<Description>IRS e-file Schema – Form 940 Schedule R Allocation Schedule for Aggregate Form 940 Filers</Description>

			<TaxYear>2026</TaxYear>

			<MaturityLevel>Schemas Version RL10A Drop 4 94x Annual</MaturityLevel>

			<ReleaseDate>September 24 2026</ReleaseDate>

		</xsd:documentation>

	</xsd:annotation>



	<xsd:include schemaLocation="../../../Common/efileTypes.xsd"/>



	<!-- ==================================================================== -->

	<!-- ====================== IRS Form 940 Schedule R ===================== -->

	<!-- ==================================================================== -->



	<xsd:element name="IRS940ScheduleR">

		<xsd:annotation>

			<xsd:documentation>IRS Form 940 Schedule R</xsd:documentation>

		</xsd:annotation>

		<xsd:complexType>

			<xsd:complexContent>

				<xsd:extension base="IRS940ScheduleRType">



					<xsd:attributeGroup ref="DocumentAttributes">

						<xsd:annotation>

							<xsd:documentation>Common return document attributes</xsd:documentation>

						</xsd:annotation>

					</xsd:attributeGroup>

					<xsd:attribute name="documentName" type="xsd:string" fixed="IRS940ScheduleR">

						<xsd:annotation>

							<xsd:documentation>IRS internal use only. To avoid error in the return, do not include the attribute name or value.</xsd:documentation>

						</xsd:annotation>

					</xsd:attribute>



				</xsd:extension>

			</xsd:complexContent>

		</xsd:complexType>

	</xsd:element>



	<xsd:complexType name="IRS940ScheduleRType">

		<xsd:annotation>

			<xsd:documentation>Content model for Form 940 Schedule R</xsd:documentation>

		</xsd:annotation>

		<xsd:sequence>

			<!-- Type of filer -->

			<xsd:choice minOccurs="0">

				<!-- Section 3504 Agent Indicator -->

				<xsd:element name="Section3504AgentInd" type="CheckboxType" minOccurs="0">

					<xsd:annotation>

						<xsd:documentation>

							<Description>Section 3504 Agent Indicator</Description>

						</xsd:documentation>

					</xsd:annotation>

				</xsd:element>	

				<!-- Certified Professional Employer Organization Indicator -->

				<xsd:element name="CPEOInd" type="CheckboxType" minOccurs="0">

					<xsd:annotation>

						<xsd:documentation>

							<Description>Certified Professional Employer Organization Indicator</Description>

						</xsd:documentation>

					</xsd:annotation>

				</xsd:element>

			</xsd:choice>

			

			<!-- Client Information Group -->

			<xsd:element name="ClientInfoGrp" maxOccurs="unbounded">

				<xsd:annotation>

					<xsd:documentation>

						<Description>Client Information Group</Description>

						<LineNumber>1 to 15</LineNumber>

					</xsd:documentation>

				</xsd:annotation>

				<xsd:complexType>

					<xsd:sequence>



						<!-- Employer Identification Number -->

						<xsd:element name="EIN" type="EINType">

									<xsd:annotation>

								<xsd:documentation>

									<Description>Employer Identification Number</Description>

									<LineNumber>Lines 1 to 15, Column (a)</LineNumber>

								</xsd:documentation>

							</xsd:annotation>

						</xsd:element>



						<!-- Federal Unemployment Tax State Code -->

						<xsd:element name="FUTAStateCd" type="FUTAStateCdType">

							<xsd:annotation>

								<xsd:documentation>

									<Description>Federal Unemployment Tax State Code</Description>

									<LineNumber>Lines 1 to 15, Column (b)</LineNumber>

								</xsd:documentation>

							</xsd:annotation>

						</xsd:element>

						

						<xsd:element name="WagesTypeCd" minOccurs="0">

							<xsd:annotation>

								<xsd:documentation>

									<Description>(CPEO Use Only) Type of wages, tips, and other compensation</Description>

									<LineNumber>Lines 1 to 15, Column (c)</LineNumber>

								</xsd:documentation>

							</xsd:annotation>

							<xsd:simpleType>

								<xsd:restriction base="TextType">

									<xsd:enumeration value="A" />

									<xsd:enumeration value="B" />

									<xsd:enumeration value="C" />

									<xsd:enumeration value="D" />

								</xsd:restriction>

							</xsd:simpleType>

						</xsd:element>



						<!-- Client Detail Group -->

						<xsd:element name="ClientDetailGrp" type="ClientDetailGrpType">

							<xsd:annotation>

								<xsd:documentation>

									<Description>Client Detail Group</Description>

									<LineNumber>Lines 1 to 15, Columns (d) to (h)</LineNumber>

								</xsd:documentation>

							</xsd:annotation>

						</xsd:element>



					</xsd:sequence>

				</xsd:complexType>

			</xsd:element>



			<!-- Subtotal For Client Information Group -->

			<xsd:element name="SubtotalForClientInfoGrp" type="ClientDetailGrpType">

				<xsd:annotation>

					<xsd:documentation>

						<Description>Subtotal For Client Information Group</Description>

						<LineNumber>16</LineNumber>

					</xsd:documentation>

				</xsd:annotation>

			</xsd:element>



			<!-- Line 17 and Continuation Sheet are not used because of 'ClientInfoGrp' -->



			<!-- Aggregate Recipient Detail Group -->

			<xsd:element name="AggregateRecipientDetailGrp" type="ClientDetailGrpType" minOccurs="0">

				<xsd:annotation>

					<xsd:documentation>

						<Description>Aggregate Recipient Detail Group</Description>

						<LineNumber>18</LineNumber>

					</xsd:documentation>

				</xsd:annotation>

			</xsd:element>



			<!-- Total Aggregate Recipient Client Information Group -->

			<xsd:element name="TotAggregateRcpntClientInfoGrp" type="ClientDetailGrpType">

				<xsd:annotation>

					<xsd:documentation>

						<Description>Total Aggregate Recipient Client Information Group</Description>

						<LineNumber>19</LineNumber>

					</xsd:documentation>

				</xsd:annotation>

			</xsd:element>



		</xsd:sequence>

	</xsd:complexType>



	<!-- Type Used for Lines 1 to 19, Columns (d) to (h) -->

	<xsd:complexType name="ClientDetailGrpType">

		<xsd:sequence>



			<!-- Total Taxable Wages Amount -->

			<xsd:element name="TotalTaxableWagesAmt" type="USDecimalAmountNNType" minOccurs="0">

				<xsd:annotation>

					<xsd:documentation>

						<Description>Total Taxable Wages Amount</Description>

						<LineNumber>Lines 1 to 19, Column (d)</LineNumber>

					</xsd:documentation>

				</xsd:annotation>

			</xsd:element>



			<!-- Total Adjustment To FUTA Tax Amount -->

			<xsd:element name="TotalAdjustmentToFUTATaxAmt" type="USDecimalAmountNNType" minOccurs="0">

				<xsd:annotation>

					<xsd:documentation>

						<Description>Total Adjustment To FUTA Tax Amount</Description>

						<LineNumber>Lines 1 to 19, Column (e)</LineNumber>

					</xsd:documentation>

				</xsd:annotation>

			</xsd:element>



			<!-- Total Credit Reduction Amount -->

			<xsd:element name="TotalCreditReductionAmt" type="USDecimalAmountNNType" minOccurs="0">

				<xsd:annotation>

					<xsd:documentation>

						<Description>Total Credit Reduction Amount</Description>

						<LineNumber>Lines 1 to 19, Column (f)</LineNumber>

					</xsd:documentation>

				</xsd:annotation>

			</xsd:element>



			<!-- FUTA Tax After Adjustment Amount -->

			<xsd:element name="FUTATaxAfterAdjustmentAmt" type="USDecimalAmountNNType" minOccurs="0">

				<xsd:annotation>

					<xsd:documentation>

						<Description>FUTA Tax After Adjustment Amount</Description>

						<LineNumber>Lines 1 to 19, Column (g)</LineNumber>

					</xsd:documentation>

				</xsd:annotation>

			</xsd:element>



			<!-- Total Tax Deposit Amount -->

			<xsd:element name="TotalTaxDepositAmt" type="USDecimalAmountNNType" minOccurs="0">

				<xsd:annotation>

					<xsd:documentation>

						<Description>Total Tax Deposit Amount</Description>

						<LineNumber>Lines 1 to 19, Column (h)</LineNumber>

					</xsd:documentation>

				</xsd:annotation>

			</xsd:element>



		</xsd:sequence>

	</xsd:complexType>	



</xsd:schema>

