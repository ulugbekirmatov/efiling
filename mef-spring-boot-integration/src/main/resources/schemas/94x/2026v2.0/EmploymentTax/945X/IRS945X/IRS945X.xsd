<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.irs.gov/efile" targetNamespace="http://www.irs.gov/efile" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
    <xsd:annotation>
        <xsd:documentation>
            <Description>IRS e-file Schema – Form 945X Annual Return of Withheld Federal Income Tax</Description>
            <TaxYear>2026</TaxYear>
            <MaturityLevel>Schemas Version RL10A Drop 4 94x Annual</MaturityLevel>
            <ReleaseDate>September 24 2026</ReleaseDate>
        </xsd:documentation>
    </xsd:annotation>
    
    <xsd:include schemaLocation="../../../Common/efileTypes.xsd"/>
    
    <!-- ============================================== -->
    <!-- =============== IRS Form 945-X =============== -->
    <!-- ============================================== -->
    
    <xsd:element name="IRS945X">
        <xsd:annotation>
            <xsd:documentation>IRS Form 945-X - Adjusted Annual Return of Withheld Federal Income Tax or Claim for Refund</xsd:documentation>
        </xsd:annotation>
        
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="IRS945XType">
                    <xsd:attributeGroup ref="DocumentAttributes">
                        <xsd:annotation>
                            <xsd:documentation>Common return document attributes</xsd:documentation>
                        </xsd:annotation>
                    </xsd:attributeGroup>
                    
                    <xsd:attribute name="documentName" type="TextType" fixed="IRS945X">
                        <xsd:annotation>
                            <xsd:documentation>IRS internal use only. To avoid errors within the return, do not include the attribute name or value.</xsd:documentation>
                        </xsd:annotation>
                    </xsd:attribute>
                    
                    <xsd:attribute name="referenceDocumentId" type="IdListType">
                        <xsd:annotation>
                            <xsd:documentation>List of document IDs of forms, schedules, supporting info. etc. attached to this form.</xsd:documentation>
                        </xsd:annotation>
                    </xsd:attribute>
                    
                    <xsd:attribute name="referenceDocumentName" type="TextType" fixed="BinaryAttachment FinalPayrollInformationStatement GeneralDependencySmall IRS945A IRSPayment TransferOfBusinessStatement"/>
                </xsd:extension>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:complexType name="IRS945XType">
        <xsd:sequence>
            <!-- Correcting Return For Year Code -->
            <xsd:element name="CorrectingReturnCalendarYrCd">
                <xsd:annotation>
                    <xsd:documentation>
                        <Description>Correcting Return For Year Code</Description>
                    </xsd:documentation>
                </xsd:annotation>
                
                <xsd:simpleType>
                    <xsd:restriction base="TextType">
                        <xsd:enumeration value="2023"/>
						<xsd:enumeration value="2024"/>
						<xsd:enumeration value="2025"/>
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            
            <!-- Error Discovered Date -->
            <xsd:element name="ErrorsDiscoveredDt" type="DateType">
                <xsd:annotation>
                    <xsd:documentation>
                        <Description>Error Discovered Date</Description>
                    </xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            
            <!-- =============== Part 1: Process Type =============== -->
            
            <xsd:choice>
                <!-- Adjusted Return Withheld Federal Income Tax Indicator -->
                <xsd:element name="AdjRetWthldFedIncmTxInd" type="CheckboxType">
                    <xsd:annotation>
                        <xsd:documentation>
                            <Description>Adjusted Return Withheld Federal Income Tax Indicator</Description>
                            <LineNumber>Line 1</LineNumber>
                        </xsd:documentation>
                    </xsd:annotation>
                </xsd:element>
                
                <!-- Claim Indicator -->
                <xsd:element name="ClaimInd" type="CheckboxType">
                    <xsd:annotation>
                        <xsd:documentation>
                            <Description>Claim Indicator</Description>
                            <LineNumber>Line 2</LineNumber>
                        </xsd:documentation>
                    </xsd:annotation>
                </xsd:element>
            </xsd:choice>
            
            <!-- =============== Part 2: Corrections Column 1 =============== -->
            
            <xsd:element name="TotalCorrectedAmount945XGrp" type="TotCorrOrigDiffTxCorr945XGrpType" minOccurs="0"/>
            
            <!-- =============== Part 2: Corrections Column 2 =============== -->
            
            <xsd:element name="OriginallyRptOrPrevCorr945XGrp" type="TotCorrOrigDiffTxCorr945XGrpType" minOccurs="0"/>
            
            <!-- =============== Part 2: Corrections Column 3 =============== -->
            
            <xsd:element name="CorrRptDifference945XGrp" minOccurs="0">
                <xsd:complexType>
                    <xsd:sequence>
                        <!-- Federal Income Tax Withheld Amount -->
                        <xsd:element name="FederalIncomeTaxWithheldAmt" type="USDecimalAmountType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
                                    <Description>Federal Income Tax Withheld Amount</Description>
                                    <LineNumber>Line 3 Column 3</LineNumber>
                                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        
                        <!-- Backup Withholding Amount -->
                        <xsd:element name="BackupWithholdingAmt" type="USDecimalAmountType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
                                    <Description>Backup Withholding Amount</Description>
                                    <LineNumber>Line 4 Column 3</LineNumber>
                                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        
                        <!-- Total Amount -->
                        <xsd:element name="TotalAmt" type="USDecimalAmountType" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>
                                    <Description>Total Amount</Description>
                                    <LineNumber>Line 5 Column 3</LineNumber>
                                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            
            <!-- =============== Part 3: Explanation =============== -->
            
            <!-- Underreported and Overreported Indicator -->
            <xsd:element name="CorrUndrptOverreportedAmtInd" type="CheckboxType" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>
                        <Description>Underreported and Overreported Indicator</Description>
                        <LineNumber>Line 6</LineNumber>
                    </xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            
            <!-- Explanation of Corrections Text -->
            <xsd:element name="CorrectionsExplanationTxt" type="MediumExplanationType">
                <xsd:annotation>
                    <xsd:documentation>
                        <Description>Explanation of Corrections Text</Description>
                        <LineNumber>Line 7</LineNumber>
                    </xsd:documentation>
                </xsd:annotation>
            </xsd:element>
			
			<!-- =============== Direct Deposit ===============-->
			<!-- Direct Deposit Group -->
            <xsd:element name="DirectDepositGrp" type="DirectDepositGrpType" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>
                        <Description>Direct Deposit Group</Description>
                    </xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>
    
    <xsd:complexType name="TotCorrOrigDiffTxCorr945XGrpType">
        <xsd:sequence>
            <!-- Federal Income Tax Withheld Amount -->
            <xsd:element name="FederalIncomeTaxWithheldAmt" type="USDecimalAmountNNType" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>
                        <Description>Federal Income Tax Withheld Amount</Description>
                        <LineNumber>Line 3 Column 1</LineNumber>
                    </xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            
            <!-- Backup Withholding Amount -->
            <xsd:element name="BackupWithholdingAmt" type="USDecimalAmountNNType" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>
                        <Description>Backup Withholding Amount</Description>
                        <LineNumber>Line 4 Column 1</LineNumber>
                    </xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>
</xsd:schema>
